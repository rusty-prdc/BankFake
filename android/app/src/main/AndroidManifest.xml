<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Интернет: только для API ассистента и картинок-аватаров -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Настоящие push-уведомления (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Автоустановка обновления: обычное разрешение, выдаётся без диалога -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Виджет «Баланс» на домашнем экране -->
        <receiver
            android:name=".BankFakeWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_bankfake_info" />
        </receiver>

        <!-- Виджет «Курсы валют» -->
        <receiver
            android:name=".RatesWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_rates_info" />
        </receiver>

        <!-- Виджет «Цели» (копилки) -->
        <receiver
            android:name=".GoalsWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_goals_info" />
        </receiver>

        <!-- Утренний брифинг: ежедневное уведомление (~9:00) -->
        <receiver
            android:name=".BriefingAlarm$Receiver"
            android:exported="false" />

        <!-- Напоминание о платеже: ежедневное уведомление в своё время -->
        <receiver
            android:name=".ReminderAlarm$Receiver"
            android:exported="false" />

        <!-- Отдаёт скачанный APK установщику Android (автообновление) -->
        <provider
            android:name=".UpdateFileProvider"
            android:authorities="org.xprodc.ivan.updateprovider"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
