# ===== BF Assistant (BankFake AI backend) =====
# Скопируйте этот файл в .env и заполните свои значения.
# Файл .env исключён из git (.gitignore) и никогда не попадает во frontend.

# ------------------------------------------------------------------
# GIGACHAT (Сбер) — ЕДИНСТВЕННАЯ нейросеть проекта.
# Получить ключ: https://developers.sber.ru (студия -> проект -> GigaChat API)
# ------------------------------------------------------------------
# Ключ авторизации GigaChat. ТОЛЬКО серверная переменная.
# Никогда не вставляйте его в HTML / JS / localStorage / URL.
GIGACHAT_AUTH_KEY=

# Модель. Примеры: GigaChat, GigaChat-2-Max, GigaChat-2-Pro, GigaChat-2-Lite.
# Список доступных вашему ключу: GET {GIGACHAT_API_URL}/models
GIGACHAT_MODEL=GigaChat

# Базовый адрес API (актуально с 17.07.2026): https://api.giga.chat/v1
# Старый, ещё работающий: https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_API_URL=https://api.giga.chat/v1

# OAuth-эндпоинт для получения access_token (документация REST API)
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth

# Область доступа (стандартная для GigaChat API)
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Схема авторизации ключа. В актуальной документации — Basic.
# Если ваш ключ выдан по старой схеме — поставьте Bearer.
GIGACHAT_AUTH_SCHEME=Basic

# ------------------------------------------------------------------
# Сервер
# ------------------------------------------------------------------
# 0.0.0.0 — чтобы backend был доступен извне (H1Cloud / локальная сеть)
HOST=0.0.0.0
# Если сайт уже занимает порт — поменяйте (фронтенд сам подхватит из адреса)
PORT=8000

# INFO | DEBUG
LOG_LEVEL=INFO

# ------------------------------------------------------------------
# Лимиты
# ------------------------------------------------------------------
# Запросов к ассистенту в минуту с одного IP (защита от перебора ключа)
RATE_LIMIT_PER_MINUTE=20
